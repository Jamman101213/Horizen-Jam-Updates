<!-- Default Volume Tables included by Audio Policy Configuration file -->
<!-- Full Default Volume table for all device category -->

<!--
"HEADSET" refers to the device's 3.5mm audio jack output.
"SPEAKER" refers to the device's built-in stereo speaker output.
 -->

<volumes>
    <reference name="FULL_SCALE_VOLUME_CURVE">
    <!-- Full Scale reference Volume Curve -->
        <point>0,0</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_SYSTEM_HEADSET_VOLUME_CURVE">
    <!-- OculusVR System Sounds Volume Curve for Headset Output -->
        <point>1,-5200</point>
        <point>7,-4800</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_SYSTEM_SPEAKER_VOLUME_CURVE">
    <!-- OculusVR System Sounds Volume Curve for Speaker Output -->
        <point>1,-5000</point>
        <point>47,-1600</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_MEDIA_HEADSET_VOLUME_CURVE">
    <!-- OculusVR Media Sounds Volume Curve for Headset Output -->
        <point>1,-5200</point>
        <point>7,-4800</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_MEDIA_SPEAKER_VOLUME_CURVE">
    <!-- OculusVR Media Stream Volume Curve for Speaker Output -->
        <point>1,-5000</point>
        <point>47,-1600</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_VOICE_HEADSET_VOLUME_CURVE">
    <!-- OculusVR Voice Stream Volume Curve for Headset Output -->
        <point>1,-3600</point>
        <point>47,-1200</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_VOICE_SPEAKER_VOLUME_CURVE">
    <!-- OculusVR Voice Stream Volume Curve for Speaker Output -->
        <point>1,-3700</point>
        <point>13,-2800</point>
        <point>47,-1400</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_NAVIGATION_HEADSET_VOLUME_CURVE">
    <!-- OculusVR Test Volume Curve for hovering over UI icons -->
        <point>1,-4700</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_NAVIGATION_SPEAKER_VOLUME_CURVE">
    <!-- OculusVR Test Volume Curve for hovering over UI icons -->
        <point>1,-2600</point>
        <point>100,0</point>
    </reference>

    <reference name="OVR_MUTED_VOLUME_CURVE">
    <!-- OculusVR Test Volume Curve to Mute specific streams -->
        <point>1,-6000</point>
        <point>100,-5400</point>
    </reference>

</volumes>
